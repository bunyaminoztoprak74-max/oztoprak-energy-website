NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_for_info_oztoprakenerji_com

# Investment leads default to Web3Forms, including on Vercel.
# WEB3FORMS_ACCESS_KEY may be used server-side; the existing public key is the fallback.
# Web3Forms keys are public form identifiers and must never be used as signing secrets.
# INVESTMENT_LEAD_DELIVERY=web3forms
# WEB3FORMS_ACCESS_KEY=<existing-form-access-key>

# Optional self-hosted encrypted disk adapter (never on Vercel):
# INVESTMENT_LEAD_DELIVERY=disk
# INVESTMENT_LEAD_STORAGE_DIR=<absolute-private-persistent-directory-outside-repo>
# INVESTMENT_LEAD_ENCRYPTION_KEY=<64-hex-characters-from-32-random-bytes>
# Set true only when your reverse proxy overwrites X-Real-IP.
# INVESTMENT_TRUST_PROXY=false
